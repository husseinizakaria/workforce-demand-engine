# TANMIA Edge Function secrets — server-side only, never in the frontend bundle.
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase in deployed functions; set them only for local runs.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the web app (invitation / password links): https://app.example.sa
APP_URL=
# Shared secret sent as the x-cron-secret header by scheduled calls
# (dispatch-notification, program-health-check). Use a long random value.
CRON_SECRET=

# Optional — AI narratives / translation (Anthropic). Without a key the platform
# reports generated_by: 'rules' and translate_questions returns 412.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
AI_MODEL=

# Optional — email delivery via Resend
RESEND_API_KEY=
# Verified sender, e.g. "TANMIA <noreply@example.sa>"
EMAIL_FROM=

# Optional — SMS / WhatsApp delivery via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number, e.g. +15005550006
TWILIO_SMS_FROM=
# WhatsApp-enabled sender, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
