# TANMIA frontend (public values only — they are embedded in the browser bundle).
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Optional: public base URL used in invitation / reset links (defaults to window.location.origin)
VITE_PUBLIC_APP_URL=https://app.example.sa

# NEVER put SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY or any other
# secret here. Server secrets belong to Edge Functions:
#   supabase secrets set --env-file supabase/functions/.env
